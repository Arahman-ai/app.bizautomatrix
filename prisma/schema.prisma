generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// AUTH
// =====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  isMaster      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  client        Client?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  CLIENT
}

// =====================
// CLIENTS & BUSINESSES
// =====================

model Client {
  id                   String        @id @default(cuid())
  userId               String        @unique
  businessName         String
  website              String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  industry             String?
  googleReviewLink     String?
  status               ClientStatus  @default(ACTIVE)
  plan                 Plan          @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  napConsistent  Boolean         @default(false)
  napNotes       String?
  setupComplete  Boolean         @default(false)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads          Lead[]
  audits         Audit[]
  subscriptions  Subscription[]
  reviewRequests ReviewRequest[]
  rankEntries    RankEntry[]
  gbpAudit       GbpAudit?
  citations      Citation[]
  seoTasks       SeoTask[]
  siteAuditRuns  SiteAuditRun[]
  competitors    Competitor[]
  pageSpeedResults PageSpeedResult[]
  marketingDrafts MarketingAgentDraft[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PRO
}

// =====================
// PROSPECTS (Google Maps scrape)
// =====================

model Prospect {
  id           String           @id @default(cuid())
  placeId      String           @unique
  businessName String
  address      String?
  city         String?
  phone        String?
  email        String?
  website      String?
  rating       Float?
  reviewCount  Int?
  category     String?
  status       ProspectStatus   @default(PENDING)
  notes        String?
  emailSentAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  marketingDrafts MarketingAgentDraft[]
  outreachLogs    OutreachEmailLog[]
}

enum ProspectStatus {
  PENDING
  APPROVED
  REJECTED
  CONTACTED
}

// =====================
// PROSPECT CONFIG (n8n scraper settings)
// =====================

model ProspectConfig {
  id                 String   @id @default("singleton")
  country            String   @default("")
  state              String   @default("")
  city               String   @default("")
  category           String   @default("")
  maxReviews         Int      @default(20)
  excludedCategories String   @default("consultant,lawyer,accountant,insurance,real_estate_agency,finance,bank,government")
  updatedAt          DateTime @updatedAt
}

// =====================
// EMAIL TEMPLATE
// =====================

model EmailTemplate {
  id        String   @id @default("singleton")
  subject   String   @default("Grow Your Business with More 5-Star Reviews")
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

// =====================
// LEADS
// =====================

model Lead {
  id           String     @id @default(cuid())
  businessName String
  ownerName    String?
  email        String
  phone        String?
  website      String?
  city         String?
  industry     String?
  source       String?    @default("audit-funnel")
  status       LeadStatus @default(NEW)
  notes        String?
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client       Client?    @relation(fields: [clientId], references: [id])
  audits       Audit[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// =====================
// AUDITS
// =====================

model Audit {
  id           String      @id @default(cuid())
  leadId       String?
  clientId     String?
  businessName String
  website      String?
  score        Int?
  summary      String?
  details      Json?
  status       AuditStatus @default(PENDING)
  emailSent    Boolean     @default(false)
  createdAt    DateTime    @default(now())

  lead         Lead?       @relation(fields: [leadId], references: [id])
  client       Client?     @relation(fields: [clientId], references: [id])
}

enum AuditStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// =====================
// SUBSCRIPTIONS
// =====================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  clientId             String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// =====================
// GBP AUDIT
// =====================

model GbpAudit {
  id              String   @id @default(cuid())
  clientId        String   @unique
  hasClaimed      Boolean  @default(false)
  hasCorrectName  Boolean  @default(false)
  hasCategory     Boolean  @default(false)
  hasDescription  Boolean  @default(false)
  hasPhotos       Boolean  @default(false)
  hasHours        Boolean  @default(false)
  hasPosts        Boolean  @default(false)
  hasServices     Boolean  @default(false)
  hasWebsite      Boolean  @default(false)
  hasPhone        Boolean  @default(false)
  reviewCount     Int?
  rating          Float?
  score           Int?
  notes           String?
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// =====================
// CITATIONS
// =====================

model Citation {
  id          String   @id @default(cuid())
  clientId    String
  directory   String
  url         String?
  listed      Boolean  @default(false)
  napCorrect  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// =====================
// SEO TASKS
// =====================

model SeoTask {
  id          String    @id @default(cuid())
  clientId    String
  task        String
  category    String    @default("general")
  priority    String    @default("MEDIUM")
  pageUrl     String?
  issueType   String?
  recommendation String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// =====================
// SITE AUDIT AUTOMATION
// =====================

model SiteAuditRun {
  id           String          @id @default(cuid())
  clientId     String
  startUrl     String
  status       String          @default("COMPLETED")
  pagesCrawled Int             @default(0)
  issuesFound  Int             @default(0)
  tasksCreated Int             @default(0)
  seoScore     Int?
  summary      String?
  createdAt    DateTime        @default(now())

  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages        SiteAuditPage[]
  issues       SiteAuditIssue[]
}

model SiteAuditPage {
  id              String          @id @default(cuid())
  auditRunId      String
  clientId        String
  url             String
  statusCode      Int?
  title           String?
  metaDescription String?
  h1              String?
  h1Count         Int             @default(0)
  h2Count         Int             @default(0)
  canonicalUrl    String?
  internalLinks   Int             @default(0)
  externalLinks   Int             @default(0)
  images          Int             @default(0)
  imagesMissingAlt Int            @default(0)
  createdAt       DateTime        @default(now())

  auditRun        SiteAuditRun    @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  issues          SiteAuditIssue[]

  @@index([clientId])
  @@index([auditRunId])
}

model SiteAuditIssue {
  id             String        @id @default(cuid())
  auditRunId     String
  pageId         String?
  clientId       String
  pageUrl        String
  issueType      String
  priority       String        @default("MEDIUM")
  recommendation String
  taskCreated    Boolean       @default(false)
  createdAt      DateTime      @default(now())

  auditRun       SiteAuditRun  @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  page           SiteAuditPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([auditRunId])
  @@index([pageId])
}

// =====================
// COMPETITORS
// =====================

model Competitor {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  website     String?
  mapRank     Int?
  websiteRank Int?
  reviewCount Int?
  rating      Float?
  notes       String?
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// =====================
// PAGESPEED
// =====================

model PageSpeedResult {
  id           String   @id @default(cuid())
  clientId     String
  url          String
  mobileScore  Int?
  desktopScore Int?
  fcp          Float?
  lcp          Float?
  cls          Float?
  tbt          Float?
  recordedAt   DateTime @default(now())

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// =====================
// RANK TRACKING
// =====================

model RankEntry {
  id          String   @id @default(cuid())
  clientId    String
  keyword     String
  productUrl  String?
  mapRank     Int?
  websiteRank Int?
  recordedAt  DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// =====================
// REVIEW REQUESTS
// =====================

model ReviewRequest {
  id             String              @id @default(cuid())
  clientId       String
  customerName   String
  customerEmail  String
  customerPhone  String?
  trackingToken  String              @unique @default(cuid())
  status         ReviewRequestStatus @default(PENDING)
  sentAt         DateTime?
  clickedAt      DateTime?
  createdAt      DateTime            @default(now())

  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ReviewRequestStatus {
  PENDING
  SENT
  CLICKED
  FAILED
}

// =====================
// MARKETING AGENT
// =====================

model MarketingAgentDraft {
  id           String               @id @default(cuid())
  clientId     String?
  prospectId   String?
  recipientEmail String?
  title        String
  channel      MarketingChannel
  audience     String               @default("BizAutomatrix prospects")
  goal         String?
  cadence      String               @default("weekly")
  content      String
  status       MarketingDraftStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  client       Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  prospect     Prospect?            @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  outreachLogs OutreachEmailLog[]

  @@index([clientId])
  @@index([prospectId])
  @@index([recipientEmail])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model OutreachEmailLog {
  id             String   @id @default(cuid())
  prospectId     String?
  draftId        String?
  recipientEmail String
  subject        String
  body           String
  status         String   @default("SENT")
  sentAt         DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  prospect       Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  draft          MarketingAgentDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([prospectId])
  @@index([draftId])
  @@index([recipientEmail])
  @@index([expiresAt])
}

enum MarketingChannel {
  EMAIL
  SMS
  WHATSAPP
  LINKEDIN
  FACEBOOK
  INSTAGRAM
}

enum MarketingDraftStatus {
  DRAFT
  REVIEWED
  APPROVED
  SENT
  SKIPPED
}
