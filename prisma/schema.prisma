generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// AUTH
// =====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  client        Client?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  CLIENT
}

// =====================
// CLIENTS & BUSINESSES
// =====================

model Client {
  id                   String        @id @default(cuid())
  userId               String        @unique
  businessName         String
  website              String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  industry             String?
  googleReviewLink     String?
  status               ClientStatus  @default(ACTIVE)
  plan                 Plan          @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads          Lead[]
  audits         Audit[]
  subscriptions  Subscription[]
  reviewRequests ReviewRequest[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PRO
}

// =====================
// PROSPECTS (Google Maps scrape)
// =====================

model Prospect {
  id           String           @id @default(cuid())
  placeId      String           @unique
  businessName String
  address      String?
  city         String?
  phone        String?
  email        String?
  website      String?
  rating       Float?
  reviewCount  Int?
  category     String?
  status       ProspectStatus   @default(PENDING)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

enum ProspectStatus {
  PENDING
  APPROVED
  REJECTED
  CONTACTED
}

// =====================
// PROSPECT CONFIG (n8n scraper settings)
// =====================

model ProspectConfig {
  id         String   @id @default("singleton")
  country    String   @default("")
  state      String   @default("")
  city       String   @default("")
  category   String   @default("")
  maxReviews Int      @default(20)
  updatedAt  DateTime @updatedAt
}

// =====================
// LEADS
// =====================

model Lead {
  id           String     @id @default(cuid())
  businessName String
  ownerName    String?
  email        String
  phone        String?
  website      String?
  city         String?
  industry     String?
  source       String?    @default("audit-funnel")
  status       LeadStatus @default(NEW)
  notes        String?
  clientId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client       Client?    @relation(fields: [clientId], references: [id])
  audits       Audit[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// =====================
// AUDITS
// =====================

model Audit {
  id           String      @id @default(cuid())
  leadId       String?
  clientId     String?
  businessName String
  website      String?
  score        Int?
  summary      String?
  details      Json?
  status       AuditStatus @default(PENDING)
  emailSent    Boolean     @default(false)
  createdAt    DateTime    @default(now())

  lead         Lead?       @relation(fields: [leadId], references: [id])
  client       Client?     @relation(fields: [clientId], references: [id])
}

enum AuditStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// =====================
// SUBSCRIPTIONS
// =====================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  clientId             String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// =====================
// REVIEW REQUESTS
// =====================

model ReviewRequest {
  id             String              @id @default(cuid())
  clientId       String
  customerName   String
  customerEmail  String
  customerPhone  String?
  trackingToken  String              @unique @default(cuid())
  status         ReviewRequestStatus @default(PENDING)
  sentAt         DateTime?
  clickedAt      DateTime?
  createdAt      DateTime            @default(now())

  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ReviewRequestStatus {
  PENDING
  SENT
  CLICKED
  FAILED
}
